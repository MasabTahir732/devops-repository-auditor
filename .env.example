# Copy to .env and fill in locally. Never commit .env or real credentials.
LLM_PROVIDER=gemini
# Fill in ONLY the key for the selected provider. Free tiers have quotas.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Leave empty to use the selected provider's default model.
LLM_MODEL=
# Defaults verified against provider documentation on 2026-10-24:
# gemini: gemini-3.8-flash | groq: openai/gpt-oss-120b | openai: gpt-4.1-mini
AUDIT_MAX_STEPS=40
AUDIT_TIMEOUT=60
AUDIT_CLONE_TIMEOUT=120
